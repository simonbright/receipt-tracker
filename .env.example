# SMTP settings for sending expense reports
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# OpenRouter — AI receipt parsing (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional: vision model (default: google/gemini-2.5-flash-lite — cheapest that handles receipts well)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Optional: shown in OpenRouter dashboard
OPENROUTER_SITE_URL=https://your-app.onrender.com
OPENROUTER_APP_NAME=Receipt Tracker

# Web Push — required for phone reminders when app is closed
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cloud sync — expenses auto-save to database (PostgreSQL on Render)
# Use the same secret for both vars so mobile + server match
SYNC_KEY=
VITE_SYNC_KEY=
# Local dev: leave DATABASE_URL empty (uses server/data/sync-data.json)
# Render: paste the FULL "Internal Database URL" from your Postgres dashboard
#   (looks like postgresql://user:pass@dpg-xxxxx-a/dbname — NOT a placeholder)
DATABASE_URL=

# Server port
PORT=3001


SYNC_KEY: d7763hjj3!999d