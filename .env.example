# SMTP settings for sending expense reports
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Optional: OpenAI API key for better receipt parsing (server-side fallback)
OPENAI_API_KEY=

# Web Push — required for phone reminders when app is closed
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Server port
PORT=3001
